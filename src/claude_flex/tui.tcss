Screen { background: #101215; color: #d6d9de; align: center middle; }
#shell { width: 86; max-width: 96%; height: auto; max-height: 92%; padding: 1 2; }
#brand { height: 2; padding-left: 1; }
OptionList { background: transparent; border: none; padding: 0; height: auto; max-height: 18; min-height: 3; }
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: #212a27; color: #e1eee7; text-style: none; }
OptionList:focus { border: none; }
#message { height: auto; max-height: 3; padding: 0 1; }
#keys { margin-top: 1; height: auto; padding: 0 1; }
.hint, .muted { color: #858b96; }
.hint { margin-top: 1; height: auto; }
Dialog, Choice, Form, LoginDialog { background: #000000 55%; align: center middle; }
.dialog { width: 66; max-width: 94%; height: auto; max-height: 90%; padding: 2 3; background: #181c20; border: round #363e42; }
.dialog-title { color: #a8d5bc; text-style: bold; height: auto; margin-bottom: 1; }
.dialog .muted { height: auto; max-height: 8; margin-bottom: 1; }
.dialog OptionList { max-height: 16; }
Label { margin-top: 1; color: #858b96; }
Input { margin-top: 0; background: #101215; border: tall #363e42; }
Input:focus { border: tall #a8d5bc; }
.buttons { height: auto; margin-top: 1; }
LoginDialog .buttons { layout: grid; grid-size: 2; grid-gutter: 1; grid-rows: auto auto; }
Button { min-width: 10; margin-right: 1; border: none; background: #2a3034; }
Button.-primary { background: #a8d5bc; color: #101215; }
.error { color: #e1a29a; height: auto; }
#device-code { color: #a8d5bc; text-style: bold; height: auto; padding: 1 0; }
#sign-in-link { height: auto; max-height: 5; overflow-y: auto; color: #858b96; }
#login-status { height: auto; margin-top: 1; }
